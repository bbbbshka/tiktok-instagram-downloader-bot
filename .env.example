# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram ID (get it from @userinfobot)
SUPER_ADMIN_ID=

# Optional: max video file size in bytes (default 50MB)
# MAX_VIDEO_SIZE=52428800

# Optional: parallel fragment downloads for faster TikTok (default 8)
# CONCURRENT_FRAGMENTS=8

# Optional: cache TTL for downloaded videos in seconds (default 3600)
# CACHE_TTL_SECONDS=3600
